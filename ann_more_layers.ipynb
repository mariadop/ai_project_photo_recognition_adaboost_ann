    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"import numpy as np\\n\",\n",
    "    \"from sklearn.model_selection import train_test_split\\n\",\n",
    "    \"from sklearn.preprocessing import LabelEncoder\\n\",\n",
    "    \"import torch\\n\",\n",
    "    \"import torch.nn as nn\\n\",\n",
    "    \"from torch.utils.data import TensorDataset, DataLoader\\n\",\n",
    "    \"\\n\",\n",
    "    \"def load_and_clean(filename):\\n\",\n",
    "    \"    return np.loadtxt(filename, skiprows=2)\\n\",\n",
    "    \"\\n\",\n",
    "    \"data_x = load_and_clean('x24x24.txt')\\n\",\n",
    "    \"data_y = load_and_clean('y24x24.txt')\\n\",\n",
    "    \"data_z = load_and_clean('z24x24.txt')\\n\",\n",
    "    \"full_data = np.vstack([data_x, data_y, data_z])\\n\",\n",
    "    \"\\n\",\n",
    "    \"X = full_data[:, :576]\\n\",\n",
    "    \"y = full_data[:, 578]\\n\",\n",
    "    \"\\n\",\n",
    "    \"label_encoder = LabelEncoder()\\n\",\n",
    "    \"y = label_encoder.fit_transform(y)\\n\",\n",
    "    \"\\n\",\n",
    "    \"X_train, X_val, y_train, y_val = train_test_split(\\n\",\n",
    "    \"    X, y,\\n\",\n",
    "    \"    test_size=0.20,\\n\",\n",
    "    \"    random_state=67,\\n\",\n",
    "    \"    stratify=y           # photos of a person will be in both sets\\n\",\n",
    "    \")\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 19\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-05-29T12:25:51.858884Z\",\n",
    "     \"start_time\": \"2026-05-29T12:25:51.830211Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"from scipy.ndimage import rotate, shift\\n\",\n",
    "    \"import numpy as np\\n\",\n",
    "    \"\\n\",\n",
    "    \"def augment_image_flat(x):\\n\",\n",
    "    \"    img = x.reshape(24, 24)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # mały obrót\\n\",\n",
    "    \"    angle = np.random.uniform(-5, 5)\\n\",\n",
    "    \"    img = rotate(img, angle, reshape=False, mode=\\\"nearest\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # małe przesunięcie max 1-2 piksele\\n\",\n",
    "    \"    dx = np.random.uniform(-1, 1)\\n\",\n",
    "    \"    dy = np.random.uniform(-1, 1)\\n\",\n",
    "    \"    img = shift(img, shift=(dy, dx), mode=\\\"nearest\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return img.reshape(-1)\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def augument_df(X_train, y_train):\\n\",\n",
    "    \"    X_aug = [X_train]\\n\",\n",
    "    \"    y_aug = [y_train]\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"    unique_classes, counts = np.unique(y_train, return_counts=True)\\n\",\n",
    "    \"    target = 100\\n\",\n",
    "    \"    for y, count in zip(unique_classes,counts):\\n\",\n",
    "    \"       X = X_train[y_train==y]\\n\",\n",
    "    \"       to_fill = target-count\\n\",\n",
    "    \"       new_img = []\\n\",\n",
    "    \"       for c in range(to_fill):\\n\",\n",
    "    \"            img = X[np.random.randint(len(X))]\\n\",\n",
    "    \"            new_img.append(augment_image_flat(img))\\n\",\n",
    "    \"       if len(new_img)>0:\\n\",\n",
    "    \"            X_aug.append(np.array(new_img))\\n\",\n",
    "    \"            y_aug.append(np.full(to_fill, y))\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return np.vstack(X_aug), np.concatenate(y_aug)\\n\"\n",
    "   ],\n",
    "   \"id\": \"349faacab0c81ad3\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 20\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-05-29T12:25:52.775853Z\",\n",
    "     \"start_time\": \"2026-05-29T12:25:51.962236Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"batch_size = 64\\n\",\n",
    "    \"learning_rate = 0.001\\n\",\n",
    "    \"epochs = 100\\n\",\n",
    "    \"\\n\",\n",
    "    \"X_train, y_train = augument_df(X_train, y_train)\\n\",\n",
    "    \"\\n\",\n",
    "    \"X_train_tensor = torch.tensor(X_train, dtype=torch.float32)\\n\",\n",
    "    \"X_val_tensor = torch.tensor(X_val, dtype=torch.float32)\\n\",\n",
    "    \"\\n\",\n",
    "    \"y_train_tensor = torch.tensor(y_train, dtype=torch.long)\\n\",\n",
    "    \"y_val_tensor = torch.tensor(y_val, dtype=torch.long)\\n\",\n",
    "    \"\\n\",\n",
    "    \"train_dataset = TensorDataset(X_train_tensor, y_train_tensor)\\n\",\n",
    "    \"test_dataset = TensorDataset(X_val_tensor, y_val_tensor)\\n\",\n",
    "    \"\\n\",\n",
    "    \"train_loader = torch.utils.data.DataLoader(train_dataset, batch_size=batch_size, shuffle=True)\\n\",\n",
    "    \"val_loader = torch.utils.data.DataLoader(test_dataset, batch_size=batch_size, shuffle=False)\\n\"\n",
    "   ],\n",
    "   \"id\": \"f699506a86d9cb11\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 21\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-05-29T12:25:52.896285Z\",\n",
    "     \"start_time\": \"2026-05-29T12:25:52.865390Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"class ANN(nn.Module):\\n\",\n",
    "    \"    def __init__(self, input_size=576, num_classes=48):\\n\",\n",
    "    \"        super().__init__()\\n\",\n",
    "    \"\\n\",\n",
    "    \"        self.network = nn.Sequential(\\n\",\n",
    "    \"            # nn.Linear(input_size, hidden_size),\\n\",\n",
    "    \"            # nn.ReLU(),\\n\",\n",
    "    \"            # nn.Dropout(0.3),\\n\",\n",
    "    \"            #\\n\",\n",
    "    \"            # nn.Linear(hidden_size, 64),\\n\",\n",
    "    \"            # nn.ReLU(),\\n\",\n",
    "    \"            # nn.Dropout(0.3),\\n\",\n",
    "    \"            #\\n\",\n",
    "    \"            # # nn.Linear(200, hidden_size),\\n\",\n",
    "    \"            # # nn.ReLU(),\\n\",\n",
    "    \"            #\\n\",\n",
    "    \"            # nn.Linear(64, num_classes)\\n\",\n",
    "    \"\\n\",\n",
    "    \"            nn.Linear(input_size, 256),\\n\",\n",
    "    \"            nn.BatchNorm1d(256),\\n\",\n",
    "    \"            nn.ReLU(),\\n\",\n",
    "    \"            nn.Dropout(0.15),\\n\",\n",
    "    \"\\n\",\n",
    "    \"            nn.Linear(256, 128),\\n\",\n",
    "    \"            nn.BatchNorm1d(128),\\n\",\n",
    "    \"            nn.ReLU(),\\n\",\n",
    "    \"            nn.Dropout(0.15),\\n\",\n",
    "    \"\\n\",\n",
    "    \"            nn.Linear(128, 64),\\n\",\n",
    "    \"            nn.ReLU(),\\n\",\n",
    "    \"\\n\",\n",
    "    \"            nn.Linear(64, num_classes)\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def forward(self, x):\\n\",\n",
    "    \"        return self.network(x)\"\n",
    "   ],\n",
    "   \"id\": \"c931afd3c8092252\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 22\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-05-29T12:25:53.033373Z\",\n",
    "     \"start_time\": \"2026-05-29T12:25:52.995331Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"num_classes = len(np.unique(y))\\n\",\n",
    "    \"\\n\",\n",
    "    \"model = ANN(\\n\",\n",
    "    \"    input_size=576,\\n\",\n",
    "    \"    num_classes=num_classes\\n\",\n",
    "    \")\"\n",
    "   ],\n",
    "   \"id\": \"8e7ac434f5a80011\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 23\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-05-29T12:25:53.141257Z\",\n",
    "     \"start_time\": \"2026-05-29T12:25:53.127887Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"criterion = nn.CrossEntropyLoss()\\n\",\n",
    "    \"optimizer = torch.optim.Adam(model.parameters(), lr=learning_rate, weight_decay=1e-4)\"\n",
    "   ],\n",
    "   \"id\": \"ea2186eeb8784476\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 24\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-05-29T12:27:25.286776Z\",\n",
    "     \"start_time\": \"2026-05-29T12:25:53.228036Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"train_losses = []\\n\",\n",
    "    \"val_losses = []\\n\",\n",
    "    \"\\n\",\n",
    "    \"train_accuracies = []\\n\",\n",
    "    \"val_accuracies = []\\n\",\n",
    "    \"\\n\",\n",
    "    \"for epoch in range(epochs):\\n\",\n",
    "    \"    #training\\n\",\n",
    "    \"    model.train()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    running_train_loss = 0.0\\n\",\n",
    "    \"    correct_train = 0\\n\",\n",
    "    \"    total_train = 0\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for X_batch, y_batch in train_loader:\\n\",\n",
    "    \"        optimizer.zero_grad()\\n\",\n",
    "    \"\\n\",\n",
    "    \"        outputs = model(X_batch)\\n\",\n",
    "    \"        loss = criterion(outputs, y_batch)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        loss.backward()\\n\",\n",
    "    \"        optimizer.step()\\n\",\n",
    "    \"\\n\",\n",
    "    \"        running_train_loss += loss.item() * X_batch.size(0)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        predictions = torch.argmax(outputs, dim=1)\\n\",\n",
    "    \"        correct_train += (predictions == y_batch).sum().item()\\n\",\n",
    "    \"        total_train += y_batch.size(0)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    epoch_train_loss = running_train_loss / total_train\\n\",\n",
    "    \"    epoch_train_accuracy = correct_train / total_train\\n\",\n",
    "    \"\\n\",\n",
    "    \"    train_losses.append(epoch_train_loss)\\n\",\n",
    "    \"    train_accuracies.append(epoch_train_accuracy)\\n\",\n",
    "    \"\\n\",\n",
    "    \"   # validation\\n\",\n",
    "    \"    model.eval()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    running_val_loss = 0.0\\n\",\n",
    "    \"    correct_val = 0\\n\",\n",
    "    \"    total_val = 0\\n\",\n",
    "    \"\\n\",\n",
    "    \"    with torch.no_grad():\\n\",\n",
    "    \"        for X_batch, y_batch in val_loader:\\n\",\n",
    "    \"            outputs = model(X_batch)\\n\",\n",
    "    \"            loss = criterion(outputs, y_batch)\\n\",\n",
    "    \"\\n\",\n",
    "    \"            running_val_loss += loss.item() * X_batch.size(0)\\n\",\n",
    "    \"\\n\",\n",
    "    \"            predictions = torch.argmax(outputs, dim=1)\\n\",\n",
    "    \"            correct_val += (predictions == y_batch).sum().item()\\n\",\n",
    "    \"            total_val += y_batch.size(0)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    epoch_val_loss = running_val_loss / total_val\\n\",\n",
    "    \"    epoch_val_accuracy = correct_val / total_val\\n\",\n",
    "    \"\\n\",\n",
    "    \"    val_losses.append(epoch_val_loss)\\n\",\n",
    "    \"    val_accuracies.append(epoch_val_accuracy)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    if (epoch + 1) % 10 == 0:\\n\",\n",
    "    \"        print(\\n\",\n",
    "    \"            f\\\"Epoch {epoch + 1}/{epochs} | \\\"\\n\",\n",
    "    \"            f\\\"train loss: {epoch_train_loss:.4f} | \\\"\\n\",\n",
    "    \"            f\\\"val loss: {epoch_val_loss:.4f} | \\\"\\n\",\n",
    "    \"            f\\\"train acc: {epoch_train_accuracy:.4f} | \\\"\\n\",\n",
    "    \"            f\\\"val acc: {epoch_val_accuracy:.4f}\\\"\\n\",\n",
    "    \"        )\"\n",
    "   ],\n",
